# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable key, sb_publishable_... (safe for the browser; legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY also works)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key, sb_secret_... (server only! legacy name SUPABASE_SERVICE_ROLE_KEY also works)
SUPABASE_SECRET_KEY=

# --- Gmail SMTP (Google Account → Security → App passwords) ---
# Short names also work: ADMIN_EMAIL (= SMTP_USER) and APP_PASSWORD (= SMTP_PASS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Shown as the sender name; Gmail always sends from SMTP_USER
MAIL_FROM_NAME=Shri Banke Bihari
# Comma-separated list that receives new-lead / application alerts
LEAD_NOTIFY_TO=sbbfinreal@gmail.com,kanpix78@gmail.com,shribankebihari80@gamil.com

# --- Public site URL (used in emails / links) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Keep-alive (no secret needed) ---
# /api/health does a tiny read so a free Supabase project doesn't pause after 7 idle days.
# Pinged by .github/workflows/keepalive.yml (add repo secret SITE_URL=https://your-domain.com)
# or by the cron in vercel.json when hosted on Vercel. Nothing to set here.
#
# --- Demo mode ---
# Leave the Supabase values above EMPTY to run the whole site + admin on a local demo
# database (.demo-db.json). Demo logins: admin@demo.in / amit@demo.in / priya@demo.in, password demo1234.
