# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon / publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key (server only!)
SUPABASE_SERVICE_ROLE_KEY=

# --- Gmail SMTP (Google Account → Security → App passwords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Shown as the sender name; Gmail always sends from SMTP_USER
MAIL_FROM_NAME=Shri Banke Bihari
# Comma-separated list that receives new-lead / application alerts
LEAD_NOTIFY_TO=owner@gmail.com

# --- Public site URL (used in emails / links) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
